{
    "name": "challenge-point-back",
    "version": "1.0.0",
    "author": "Verticode",
    "scripts": {
        "build": "node build.js",
        "dev": "nodemon",
        "start": "node dist/index.js",
        "sync:affordances": "ts-node --files -r tsconfig-paths/register ./src/run-sync-affordances.ts",
        "sync:constraints": "ts-node --files -r tsconfig-paths/register ./src/run-sync-constraints.ts",
        "integrity-review": "ts-node src/scripts/run-integrity-review.ts",
        "test": "node scripts/test-parallel.js",
        "test:serial": "node scripts/test-parallel.js --serial",
        "test:selection-pipeline": "ts-node --files -r tsconfig-paths/register ./src/scripts/run-selection-pipeline-tests.ts",
        "test:parallel": "node scripts/test-parallel.js",
        "snapshot": "node ./scripts/regression-snapshot.js",
        "snapshot:diff": "node ./scripts/regression-diff.js",
        "test:create-activity-local": "node .\\run-local-create-activity-test.js",
        "corpus:diagnostic": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-corpus-diagnostic.ts",
        "corpus:game": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-resolved-game.ts",
        "realize": "ts-node --files -r tsconfig-paths/register ./src/system/realization/run-realization.ts",
        "corpus:coverage": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-contract-coverage.ts",
        "bounded:selection": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-bounded-selection.ts",
        "corpus:unestablished": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-unestablished-evidence.ts",
        "lens:trace": "ts-node --files -r tsconfig-paths/register ./src/system/test-library/run-lens-causal-trace.ts",
        "corpus:placement": "ts-node --files -r tsconfig-paths/register ./src/system/derivation/run-placement-test.ts",
        "first:game": "ts-node --files -r tsconfig-paths/register ./src/system/realization/run-first-game.ts",
        "freeze:a04": "ts-node --files -r tsconfig-paths/register ./src/system/rendering/freeze-a04-fixture.ts",
        "render:a04": "ts-node --files -r tsconfig-paths/register ./src/system/rendering/run-render-a04.ts",
        "pilot:a04": "ts-node --files -r tsconfig-paths/register ./src/system/rendering/run-pilot-a04.ts"
    },
    "nodemonConfig": {
        "env": {
            "NODE_ENV": "development"
        },
        "watch": [
            "src"
        ],
        "ext": "ts, html",
        "ignore": [
            "src/public"
        ],
        "exec": "./node_modules/.bin/ts-node --files -r tsconfig-paths/register ./src"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.744.0",
        "@aws-sdk/s3-request-presigner": "^3.744.0",
        "bcrypt": "^5.0.1",
        "boilerplate": "file:..",
        "chalk": "^4.1.2",
        "challenge-point": "file:..",
        "command-line-args": "^5.2.1",
        "cors": "^2.8.5",
        "date-fns": "^3.6.0",
        "dotenv": "^16.4.7",
        "express": "^4.18.1",
        "express-async-errors": "^3.1.1",
        "helmet": "^8.0.0",
        "http-status-codes": "^2.2.0",
        "jsonwebtoken": "^8.5.1",
        "mongoose": "^8.9.3",
        "morgan": "^1.10.0",
        "node-mailjet": "^5.1.1",
        "openai": "^6.34.0",
        "uuid": "^9.0.0",
        "winston": "^3.17.0",
        "winston-mongodb": "^6.0.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/command-line-args": "^5.2.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.13",
        "@types/fs-extra": "^9.0.13",
        "@types/jsonwebtoken": "^8.5.8",
        "@types/morgan": "^1.9.3",
        "@types/node": "^18.7.6",
        "@types/uuid": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^5.33.1",
        "@typescript-eslint/parser": "^5.33.1",
        "esbuild": "^0.23.1",
        "eslint": "^8.22.0",
        "fs-extra": "^10.1.0",
        "nodemon": "^2.0.19",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.1.0",
        "typescript": "^4.7.4"
    }
}
